class ImovelRepositorio(RepositorioBase):
    tabela = "Imovel"
    classe_entidade = Imovel
    pk = "id_imovel"
    # status_imovel e data_cadastro têm valor padrão no banco: não pedimos
    # isso no cadastro, só permitimos editar depois (ex.: marcar Vendido)
    colunas_inserir = ["id_proprietario", "id_tipo_imovel", "id_endereco", "valor_sugerido"]
    colunas_atualizar = ["id_proprietario", "id_tipo_imovel", "id_endereco", "valor_sugerido", "status_imovel"]
    nome_exibicao = "Imóvel"
    msg_erro_atualizar = "verifique se o ID do proprietário, tipo do imóvel e endereço existem."
    msg_erro_deletar = "ele está associado a Visitas, Anúncios, Documentos, Vendas ou Aluguéis."

    def listar_detalhado(self):
        """Listagem com nomes legíveis (proprietário, tipo, endereço) em vez de IDs cruas."""
        sql = """
        SELECT
            i.id_imovel, p.nome AS proprietario, t.descricao AS tipo_imovel,
            e.rua, e.numero, i.valor_sugerido, i.status_imovel, i.data_cadastro
        FROM Imovel i
        JOIN Proprietario p ON i.id_proprietario = p.id_proprietario
        JOIN TipoImovel t ON i.id_tipo_imovel = t.id_tipo_imovel
        JOIN Endereco e ON i.id_endereco = e.id_endereco
        """
        with Conexao() as db:
            db.cursor.execute(sql)
            return db.cursor.fetchall()
